# ─────────────────────────────────────────────────────────────
# Mise — Environment Variables
# Copy to .env and fill in values for your environment.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise
POSTGRES_DB=mise
DATABASE_URL=postgresql+psycopg://mise:mise@postgres:5432/mise

# ── Cache (Dragonfly / Redis) ─────────────────────────────────
REDIS_URL=redis://dragonfly:6379/0

# ── Messaging (NATS) ─────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── Identity (Keycloak) ──────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=mise
KEYCLOAK_AUDIENCE=mise-web

# ── Object Storage (MinIO) ───────────────────────────────────
MINIO_ROOT_USER=mise
MINIO_ROOT_PASSWORD=mise-minio

# ── Search (Meilisearch) ─────────────────────────────────────
MEILI_MASTER_KEY=mise-dev

# ── AI Service ────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-me

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

# ── Web App ───────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://traefik
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_DEBUG=false
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/mise
DOCS_PORT=3010
